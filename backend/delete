# ============================
# Email Sequencing Module — Environment Variables
# ============================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ─── Server ─────────────────────────────────────────
PORT=5000
NODE_ENV=development
API_PREFIX=/api
APP_BASE_URL=http://localhost:5000

# ─── MongoDB ────────────────────────────────────────
# Local:   mongodb://localhost:27017/email_sequencing
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/email_sequencing
MONGO_URI=mongodb://localhost:27017/email_sequencing
MONGO_MAX_POOL_SIZE=10

# ─── Redis ──────────────────────────────────────────
# Local:   redis://localhost:6379
# Upstash: redis://:password@host:port
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# ─── Authentication ─────────────────────────────────
JWT_SECRET=dev_jwt_secret_key_change_in_production_!!!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev_refresh_secret_key_change_in_production_!!
JWT_REFRESH_EXPIRES_IN=30d

# ─── Encryption ─────────────────────────────────────
# Must be exactly 32 characters for AES-256
ENCRYPTION_KEY=dev_local_32char_key_replace_me!
ENCRYPTION_IV_LENGTH=16

# ─── Email / SMTP ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=shreyaskale06@gmail.com
SMTP_PASS=cetnuzyhowatezze
SMTP_FROM_NAME=Email
SMTP_FROM_EMAIL=shreyaskale06@gmail.com

# ─── BullMQ / Queue ──────────────────────────────────
QUEUE_CONCURRENCY=5
EMAIL_QUEUE_NAME=email-sequence
RETRY_ATTEMPTS=3
RETRY_BACKOFF_DELAY=5000

# ─── Rate Limiting ───────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS ────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ─── Logging ─────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ─── Frontend (for reference) ────────────────────────
FRONTEND_URL=http://localhost:5173
