# ============================
# Email Sequencing Module — Environment Variables
# ============================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ─── Server ─────────────────────────────────────────
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# ─── MongoDB ────────────────────────────────────────
# Local:   mongodb://localhost:27017/email_sequencing
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/email_sequencing
MONGO_URI=mongodb://localhost:27017/email_sequencing
MONGO_MAX_POOL_SIZE=10

# ─── Redis ──────────────────────────────────────────
# Local:   redis://localhost:6379
# Upstash: redis://:password@host:port
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# ─── Authentication ─────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Optional: dedicated signing secret for unsubscribe tokens (falls back to JWT_SECRET)
# Must be at least 32 characters. Rotate this to invalidate all existing unsubscribe links.
# UNSUBSCRIBE_SECRET=your_separate_unsubscribe_secret_32_chars_min

# ─── Encryption ─────────────────────────────────────
# Must be exactly 32 characters for AES-256
ENCRYPTION_KEY=your_32_char_encryption_key_here!
ENCRYPTION_IV_LENGTH=16

# ─── Email / SMTP ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Email Sequencing Module
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ─── BullMQ / Queue ──────────────────────────────────
QUEUE_CONCURRENCY=5
EMAIL_QUEUE_NAME=email-sequence
RETRY_ATTEMPTS=3
RETRY_BACKOFF_DELAY=5000

# ─── Rate Limiting ───────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── CORS ────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ─── Logging ─────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ─── Frontend (for reference) ────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── AI / Gemini ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ─── Razorpay (Billing) ───────────────────────────────────────────────
# Obtain these from https://dashboard.razorpay.com (Test Mode)
# Settings → API Keys → Generate Test Key
#
# SECURITY RULES:
#   RAZORPAY_KEY_SECRET     — backend ONLY. Never in frontend. Never in logs.
#   RAZORPAY_WEBHOOK_SECRET — backend ONLY. Never in frontend. Never in logs.
#   RAZORPAY_KEY_ID         — safe to return to Checkout (public credential).
#
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Must remain 'test' until explicitly switching to production.
RAZORPAY_MODE=test
